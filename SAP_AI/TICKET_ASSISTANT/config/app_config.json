{
  "application_name": "SAP AI Ticket Assistant",
  "version": "1.0.0",
  "data_root": "TicketData",
  "database_path": "TicketData/ticket_assistant.db",
  "allow_live_screenshot_capture": false,
  "require_sanitized_evidence_confirmation": true,
  "screenshot_delay_seconds": 3,
  "allowed_ticket_pattern": "^[A-Za-z]{2,10}[0-9]{3,12}$",
  "report_filename_suffix": "_analysis.docx",
  "organization_name": "Your Organization",
  "retention_notice": "Evidence must be retained and deleted according to organizational policy."
}